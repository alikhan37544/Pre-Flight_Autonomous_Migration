# PreFlight live reasoning (optional)
# Copy to .env and fill in. Never commit .env.
PREFLIGHT_LLM_MODE=off
PREFLIGHT_LLM_BASE_URL=
PREFLIGHT_LLM_API_KEY=
PREFLIGHT_LLM_MODEL=mimo-v2.6-flash
PREFLIGHT_LLM_FALLBACK_MODEL=mimo-v2.6-pro
PREFLIGHT_LLM_TIMEOUT=45
# Only enable this for synthetic or explicitly approved code.
PREFLIGHT_LLM_ALLOW_REAL_CODE=false
